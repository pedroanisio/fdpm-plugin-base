# Environment for an FDPM host that should load this plugin.
#
# The FDPM host has no dotenv support -- it reads process.env only. Nothing
# sources this file automatically; whatever starts the host must do it, e.g.
#
#   set -a; . .env; set +a; fdpm plugin list
#
# `npm run deploy` copies dist/ into FDPM_PLUGIN_PATH under the directory name
# the host discovers. Copy this file to .env and adjust the paths.

# Where the host looks for plugin directories. Each entry is a directory whose
# CHILD directories each contain an fdpm-plugin.json. Colon-separated on POSIX.
# Symlinked children are skipped by discovery, so deploy by copying.
FDPM_PLUGIN_PATH=/home/admin/.fdpm/plugins

# Trust. A plugin outside the CLI tree infers `community`, and the host
# auto-activates only `core` and `verified` -- so without this the profile is
# discovered, left disabled, and never registered. The host plaintext-matches
# this list against `trust.signed_by` in fdpm-plugin.json; there is no
# signature verification. Control of FDPM_PLUGIN_PATH is the real trust
# decision.
FDPM_TRUSTED_KEYS=pedroanisio-local

# Where workbooks and their operation logs live.
FDPM_DATA_DIR=/home/admin/.fdpm-cli

# Plugin startup log threshold: debug | info | warn | error | silent.
FDPM_LOG_LEVEL=warn
